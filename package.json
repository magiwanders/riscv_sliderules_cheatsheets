{
  "name": "@magiwanders/riscv-sliderules-cheatsheets",
  "private": false,
  "version": "0.4.0",
  "description": "Instruction encoder / decoder sliderules for the web: RISC-V (RV32GC), Z80, 6502, Hack",
  "license": "CC-BY-SA-4.0",
  "author": "Simone Shawn Cazzaniga <shawn@magiwanders.com> (https://www.magiwanders.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/magiwanders/riscv_sliderules_cheatsheets.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node src/isa/api-gen.js && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "vectors": "node test/gen-gnu-vectors.mjs",
    "vectors:retro": "node test/gen-retro-vectors.mjs",
    "isa": "node tools/isa/gen-rv32gc.mjs && node tools/isa/gen-mos6502.mjs && node tools/isa/gen-retro.mjs",
    "isa:tablegen": "node tools/isa/tablegen.mjs",
    "vectors:llvm": "node test/gen-llvm-vectors.mjs",
    "vectors:retro-asm": "node test/gen-retro-assembler-vectors.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/magiwanders/riscv-sliderules-cheatsheets"
  }
}
