      "section": "c6",
      "format": "IND",
      "title": "Compare Indirect RAM and Jump",
      "pseudocode": "if ( [ Ri ] != data ) PC += rel"
    },
    "rn-1": {
      "section": "c8",
      "format": "REG",
      "title": "On a Register",
      "pseudocode": "A = A (op) Rn ..."
    },
    "rn-2": {
      "section": "c8",
      "format": "REG",
      "title": "Register with a Second Operand",
